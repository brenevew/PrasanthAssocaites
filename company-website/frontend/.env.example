# ─── Frontend Environment Variables Template ──────────────────────────
# Copy to .env.local for local development:  cp .env.example .env.local
# .env.local is gitignored — never commit real secrets.

# Public (inlined into the browser bundle at build time — no secrets here)
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID. Inlined at BUILD time, so on Cloudflare it
# must be a build variable for production. Leave empty in development so local
# testing doesn't pollute real reports; no tag loads when it's empty.
# Production value: G-NJWX2XYRQZ
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# "true" sends events to GA4 DebugView (Admin > DebugView). Never set in production.
NEXT_PUBLIC_GA_DEBUG=

# Production builds must use https://prasanthassociates.com above so canonical
# URLs and the sitemap point to the public website.
# Optional Search Console URL-prefix verification: paste only the content value
# from Google's HTML meta tag, then rebuild/redeploy. This value is public.
# Not needed if the Domain property is already verified through a DNS TXT record.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools "HTML meta tag" method: paste only the content value
# (covers Bing, Yahoo and DuckDuckGo). Not needed if you import the site from
# Google Search Console or verify by DNS. Optional Yandex equivalent below.
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# ─── Google Sheets form ingestion (server-side only) ──────────────────
# Receives submissions from all three forms: Contact, Request Quote and
# Building Planner. Setup instructions: /GOOGLE_SHEETS_DEPLOYMENT.md
#
# The deployed Google Apps Script web app URL. Must end in /exec.
# If unset, forms still succeed and each lead is written to the server log
# instead of the Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared token checked by the Apps Script before it writes a row. Must match
# the SHARED_SECRET script property in the Apps Script project.
# Generate with: openssl rand -hex 24
GOOGLE_SHEETS_SHARED_SECRET=

# ─── Self-hosting with more than one replica ──────────────────────────
# The Contact and Request Quote forms use Server Actions. Every replica must
# share one stable key or submissions fail after a scale-out or rolling deploy.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
