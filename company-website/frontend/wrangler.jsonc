{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers & Pages),
  // or Workers Builds refuses to deploy. Also used by the self-reference below.
  "name": "prasanthassocaites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep the plaintext variables set in the dashboard (NEXT_PUBLIC_SITE_URL).
  // Without this, a deploy from this file deletes any variable not listed here.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext calls back into its own Worker; the service name must equal "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prasanthassocaites"
    }
  ],
  "r2_buckets": [
    {
      // Incremental cache for pre-rendered pages (see open-next.config.ts).
      // Create the bucket before the first deploy:
      //   npx wrangler r2 bucket create prasanthassocaites-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "prasanthassocaites-opennext-cache"
    }
  ],
  "images": {
    // next/image optimisation through Cloudflare Images.
    "binding": "IMAGES"
  },
  "observability": {
    // Worker logs in the dashboard, so errors like 1102 can be traced.
    "enabled": true
  }
}
