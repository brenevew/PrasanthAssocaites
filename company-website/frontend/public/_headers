# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Files in public/ are served by Cloudflare's static assets, which never see the
# headers() rules in next.config.ts — so cache rules for them live here.

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos and other media: same policy as next.config.ts. Not `immutable`, so
# replacing a file under the same name still rolls out.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
